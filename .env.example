APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Suscripción SaaS de Gintly (Lemon Squeezy). Solo placeholders; NUNCA valores reales.
# Propósito de despliegue y modo del proveedor (independientes de APP_ENV). Combinaciones válidas:
#   BILLING_DEPLOYMENT_PURPOSE=commercial  →  BILLING_PROVIDER_MODE=live
#   BILLING_DEPLOYMENT_PURPOSE=demo        →  BILLING_PROVIDER_MODE=test
BILLING_DEPLOYMENT_PURPOSE=demo
BILLING_PROVIDER_MODE=test
# Optional evaluation of ONE selected business, granted/revoked by billing:demo-access (not checkout).
BILLING_DEMO_ACCESS_ENABLED=false
BILLING_DEMO_BUSINESS_SLUG=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_API_BASE=https://api.lemonsqueezy.com/v1
BILLING_HTTP_TIMEOUT=15
BILLING_LOCK_TIMEOUT=10
BILLING_CHECKOUT_MAX_PER_MINUTE=10
BILLING_CHECKOUT_TTL_MINUTES=60
BILLING_PROVIDER_PAGE_CAP=10
BILLING_CHECKOUT_RECOVERY_GRACE=90
BILLING_RETURN_URL=
BILLING_CANCEL_URL=
# Variantes reales (3 planes × 2 periodicidades) por modo; separadas test/live.
LS_TEST_VARIANT_BASIC_MONTHLY=
LS_TEST_VARIANT_BASIC_ANNUAL=
LS_TEST_VARIANT_COMERCIO_MONTHLY=
LS_TEST_VARIANT_COMERCIO_ANNUAL=
LS_TEST_VARIANT_CADENA_MONTHLY=
LS_TEST_VARIANT_CADENA_ANNUAL=
LS_LIVE_VARIANT_BASIC_MONTHLY=
LS_LIVE_VARIANT_BASIC_ANNUAL=
LS_LIVE_VARIANT_COMERCIO_MONTHLY=
LS_LIVE_VARIANT_COMERCIO_ANNUAL=
LS_LIVE_VARIANT_CADENA_MONTHLY=
LS_LIVE_VARIANT_CADENA_ANNUAL=
